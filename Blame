a. T(n)=2T(n/2)+n

public class Main {

    static long T(int n) {
        if (n <= 1)
            return 1;

        return 2 * T(n / 2) + (long) Math.pow(n, 4);
    }

    public static void main(String[] args) {
        int n = 16;
        System.out.println(T(n));
    }
}
b. T(n)=T(7n/10)+n
public class Main {

    static long T(int n) {
        if (n <= 1)
            return 1;

        return T((7 * n) / 10) + n;
    }

    public static void main(String[] args) {
        int n = 100;
        System.out.println(T(n));
    }
}
